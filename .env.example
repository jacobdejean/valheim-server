# ---- Copy to .env and fill in values ----

# Server identity
SERVER_NAME=My Valheim Server
# IMPORTANT: must exactly match your world filename (without extension),
# e.g. if your save is "Midgard.db"/"Midgard.fwl" -> WORLD=Midgard
WORLD=Dedicated
PASSWORD=lacroix
PORT=2456
PUBLIC=0
TZ=America/Chicago

# Rootless container user. On Linux run `id -u` / `id -g`.
# On macOS Docker Desktop 1000:1000 works fine regardless of your real UID.
PUID=1000
PGID=1000

# Discord webhook (optional, leave blank to disable)
WEBHOOK_URL=

# QoL toggles
AUTO_UPDATE=1
AUTO_UPDATE_SCHEDULE=0 3 * * *
AUTO_UPDATE_PAUSE_WITH_PLAYERS=1

AUTO_BACKUP=1
AUTO_BACKUP_SCHEDULE=*/30 * * * *
AUTO_BACKUP_DAYS_TO_LIVE=3

SCHEDULED_RESTART=0
SCHEDULED_RESTART_SCHEDULE=0 4 * * *
